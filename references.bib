	shorttitle = {Towards {Pluralism}-{Aware} {Sign} {Language} {Technologies}},
	url = {https://escholarship.org/uc/item/29d7q840},
	abstract = {d/Deaf people who prefer to use sign language have long faced challenges in accessing information and communication in hearing-dominated societies because many native signers learn written/spoken languages as a second language. Although researchers have worked hard on communication technologies for d/Deaf people, the complexity of d/Deaf communication in real-world scenarios, especially multilingualism and multiculturalism, has received relatively little attention in the HCI community. This study seeks to advance empirical understanding of d/Deaf communication through a case analysis of translation work conducted by online d/Deaf content creators in China. Based on semi-structured interviews with 13 d/Deaf content creators in China, I found that my participants faced a wide variety of languages and cultures when sharing content with a large audience from mixed language and cultural backgrounds. Hence, they had to connect a wide range of meaning-making systems, e.g., their full linguistic repertoire, to establish communication and also avoid miscommunication with various audiences. These findings will inform design of communication technologies for d/Deaf people, while also posing challenges to sign language technologies. Based on the findings, I argue for a pluralism-aware design approach when building sign language technologies.},
	language = {en},
	urldate = {2025-04-08},
	school = {UC Irvine},
	author = {Tang, Xinru},
	year = {2023},
}

@inproceedings{jiang_beyond_2023,
	address = {New York, NY, USA},
	series = {{ASSETS} '23},
	title = {Beyond {Audio} {Description}: {Exploring} 360° {Video} {Accessibility} with {Blind} and {Low} {Vision} {Users} {Through} {Collaborative} {Creation}},
	isbn = {979-8-4007-0220-4},
	shorttitle = {Beyond {Audio} {Description}},
	url = {https://doi.org/10.1145/3597638.3608381},
	doi = {10.1145/3597638.3608381},
	abstract = {While audio description (AD) is a standard method for making traditional videos more accessible to blind and low vision (BLV) users, we lack an understanding of how to make 360° videos accessible while preserving their immersive nature. Through individual interviews and collaborative design workshops, we explored ways to improve 360° video accessibility with immersion and engagement in mind. Our design workshops presented a unique opportunity for participants with diverse backgrounds to build on each others’ personal and professional experiences and collaboratively develop accessible 360° video prototypes. Participants included both AD creators and users, with a focus on BLV AD creators as their perspectives are underrepresented in prior work. We found that immersive video accessibility went beyond an extension of traditional video accessibility techniques. Participants valued accurate vocabulary and different points of view for descriptions, preferred a variety of presentation locations for spatialized AD, appreciated sound effects for setting the mood and subtly guiding, and wished to engage multiple senses to boost engagement. We conclude with implications for immersive media accessibility and future research directions to support disabled people as creators of access technology.},
	urldate = {2025-04-08},
	booktitle = {Proceedings of the 25th {International} {ACM} {SIGACCESS} {Conference} on {Computers} and {Accessibility}},
	publisher = {Association for Computing Machinery},
	author = {Jiang, Lucy and Phutane, Mahika and Azenkot, Shiri},
	month = oct,
	year = {2023},
	pages = {1--17},
}

