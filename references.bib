@article{lyu_i_2024,
	title = {"{I} {Upload}... {All} {Types} of {Different} {Things} to {Say} the {World} of {Blindness} {Is} {More} {Than} {What} {They} {Think} {It} {Is}": {A} {Study} of {Blind} {TikTokers}' {Identity} {Work} from a {Flourishing} {Perspective}},
	volume = {8},
	shorttitle = {"{I} {Upload}... {All} {Types} of {Different} {Things} to {Say} the {World} of {Blindness} {Is} {More} {Than} {What} {They} {Think} {It} {Is}"},
	url = {https://dl.acm.org/doi/10.1145/3687013},
	doi = {10.1145/3687013},
	abstract = {Identity work in Human-Computer Interaction (HCI) has examined the asset-based design of marginalized groups who use technology to improve their quality of life. Our study illuminates the identity work of people with disabilities, specifically, visual impairments. We interviewed 45 BlindTokers (blind users on TikTok) from various backgrounds to understand their identity work from a positive design perspective. We found that BlindTokers leverage the affordance of the platform to create positive content, express their identities, and build communities with the desire to flourish. We proposed flourishing labor to present the work conducted by BlindTokers for their community's flourishing with implications to support the flourishing labor. This work contributes to understanding blind users' experience in short video platforms and highlights that flourishing is not just an activity for any single blind user but also a collective effort that necessitates serious and committed contributions from platforms and the communities they serve.},
	number = {CSCW2},
	urldate = {2025-04-14},
	journal = {Proc. ACM Hum.-Comput. Interact.},
	author = {Lyu, Yao and Cai, Jie and Dosono, Bryan and Yadav, Davis and Carroll, John M.},
	month = nov,
	year = {2024},
	pages = {474:1--474:24},
}

