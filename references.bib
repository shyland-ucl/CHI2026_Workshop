@article{janneck_web_2010,
	title = {Web {Information} {Systems} and {Technologies}, 5th {International} {Conference}, {WEBIST} 2009, {Lisbon}, {Portugal}, {March} 23-26, 2009, {Revised} {Selected} {Papers}},
	issn = {1865-1348},
	doi = {10.1007/978-3-642-12436-5_14},
	abstract = {Mechanisms supporting a shared representation of activities — or awareness—within a group of people are an important prerequisite for successful computer supported collaborative activities. This article highlights the design of awareness support from a social psychological viewpoint of human behaviour in and within groups. Based on this, design guidelines for awareness support in distributed collaboration—with an emphasis on promoting social awareness—are proposed and evaluated empirically. Results show that users awareness was influenced positively as predicted by the design guidelines.},
	journal = {Lecture Notes in Business Information Processing},
	author = {Janneck, Monique},
	year = {2010},
	pages = {185--197},
}

@article{bolstad_tools_2003,
	title = {Tools for {Supporting} {Team} {Collaboration}},
	volume = {47},
	issn = {1541-9312},
	doi = {10.1177/154193120304700326},
	abstract = {Collaboration plays an important role in team tasks. Teams are also functioning more often in a distributed fashion. If individuals are to work efficiently in a distributed fashion they will need collaborative tools and systems to exchange information and most importantly Situation Awareness (SA). Little guidance exists as to which tools are appropriate for collaborative tasks or situations. The present paper presents a taxonomy of collaboration and, based on this taxonomy, information is provided on which classes of collaborative tools and techniques are most useful for different types of tasks and situations.},
	number = {3},
	journal = {Proceedings of the Human Factors and Ergonomics Society Annual Meeting},
	author = {Bolstad, Cheryl A. and Endsley, Mica R.},
	year = {2003},
	pages = {374--378},
}

